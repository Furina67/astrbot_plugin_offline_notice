{
  "heartbeat_interval": {
    "description": "心跳检测间隔（秒）",
    "type": "int",
    "default": 180,
    "hint": "每隔多少秒检测一次账号在线状态"
  },
  "email_config": {
    "description": "邮件发送配置",
    "type": "object",
    "hint": "配置用于发送离线通知的 SMTP 邮箱信息",
    "items": {
      "username": {
        "description": "发信邮箱用户名",
        "type": "string",
        "hint": "用于登录 SMTP 服务器的用户名，通常与发信地址相同"
      },
      "sender": {
        "description": "发信地址",
        "type": "string",
        "hint": "邮件显示的发件人地址，一般与发信邮箱用户名相同"
      },
      "password": {
        "description": "发信邮箱密码/授权码",
        "type": "string",
        "hint": "SMTP 登录密码或授权码。"
      },
      "display_name": {
        "description": "发件人显示名称",
        "type": "string",
        "default": "AstrBot 离线通知",
        "hint": "收件人看到的发件人名称"
      },
      "smtp_server": {
        "description": "SMTP 服务器地址",
        "type": "string",
        "hint": "例如 smtp.qq.com"
      },
      "smtp_port": {
        "description": "SMTP 端口号",
        "type": "int",
        "default": 465,
        "hint": "SSL 通常为 465，TLS 通常为 587，不加密通常为 25"
      },
      "encryption": {
        "description": "加密类型",
        "type": "string",
        "options": [
          "SSL",
          "TLS",
          "不启用"
        ],
        "default": "SSL",
        "hint": "SMTP 连接使用的加密方式"
      },
      "recipients": {
        "description": "通知收件人邮箱列表",
        "type": "list",
        "default": [],
        "hint": "离线通知将发送到这些邮箱地址"
      }
    }
  },
  "email_template": {
    "description": "邮件模板配置",
    "type": "object",
    "hint": "自定义邮件主题和正文，支持魔法变量：{{user_id}}、{{nickname}}、{{timestamp}}、{{platform}}、{{offline_reason}}",
    "items": {
      "subject": {
        "description": "邮件主题模板",
        "type": "text",
        "editor_mode": true,
        "editor_language": "text",
        "default": "您的账号 {{nickname}}({{user_id}}) 已于 {{timestamp}} 离线",
        "hint": "支持魔法变量：{{user_id}}、{{nickname}}、{{timestamp}}、{{platform}}、{{offline_reason}}"
      },
      "body": {
        "description": "邮件正文模板",
        "type": "text",
        "editor_mode": true,
        "editor_language": "html",
        "default": "<div style=\"max-width:600px;margin:0 auto;font-family:Arial,sans-serif;color:#333;\">\n  <div style=\"background:#e74c3c;padding:20px;border-radius:8px 8px 0 0;\">\n    <h1 style=\"color:#fff;margin:0;font-size:22px;\">⚠️ 账号离线通知</h1>\n  </div>\n  <div style=\"background:#fff;padding:25px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px;\">\n    <p style=\"font-size:15px;line-height:1.6;\">检测到 <strong>AstrBot</strong> 账号已离线，以下是详细信息：</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:15px 0;\">\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;width:100px;\">账号 ID</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{user_id}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">昵称</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{nickname}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">平台</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{platform}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">检测时间</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{timestamp}}</td></tr>\n    </table>\n    {{offline_reason}}\n    <p style=\"color:#e74c3c;font-size:14px;\">请及时前往协议端检查处理。</p>\n  </div>\n  <div style=\"text-align:center;padding:15px;color:#999;font-size:12px;\">Powered By：香草味的纳西妲喵（VanillaNahida） | 此邮件由 AstrBot 离线通知插件自动发送</div>\n</div>",
        "hint": "支持 HTML 格式，可使用魔法变量：{{user_id}}、{{nickname}}、{{timestamp}}、{{platform}}、{{offline_reason}}"
      }
    }
  },
  "webhook": {
    "description": "SnowLuma Webhook 配置",
    "type": "object",
    "hint": "配置接收 SnowLuma 状态通知的 Webhook 服务器",
    "items": {
      "host": {
        "description": "Webhook 服务器主机名",
        "type": "string",
        "default": "127.0.0.1",
        "hint": "监听地址，默认为 127.0.0.1"
      },
      "port": {
        "description": "Webhook 服务器端口",
        "type": "int",
        "default": 3051,
        "hint": "监听端口，默认为 3051"
      },
      "access_token": {
        "description": "访问令牌",
        "type": "string",
        "default": "",
        "hint": "用于验证请求的访问令牌（可选）"
      },
      "webhook_url": {
        "description": "Webhook 地址（自动生成，请勿修改！）",
        "type": "string",
        "default": "",
        "hint": "此字段由插件自动生成，请勿手动修改！保存配置后插件重载时将自动生成完整的 Webhook 地址，把这个填写到SnowLuma的 Webhook 配置中即可"
      },
      "webhook_body_template": {
        "description": "Webhook Body 模板（自动生成，请勿修改！）",
        "type": "text",
        "editor_mode": true,
        "editor_language": "json",
        "default": "",
        "hint": "此字段由插件自动生成，请勿手动修改！请将此 JSON 模板填写到 SnowLuma 的 Webhook Body 配置中"
      }
    }
  },
  "snowluma_email_template": {
    "description": "SnowLuma 通知邮件模板配置",
    "type": "object",
    "hint": "自定义 SnowLuma 状态通知邮件的主题和正文，支持模板变量：{{title}}、{{uin}}、{{nickname}}、{{event}}、{{time}}、{{desp}}、{{desp_html}}",
    "items": {
      "subject": {
        "description": "邮件主题模板",
        "type": "text",
        "editor_mode": true,
        "editor_language": "text",
        "hint": "支持模板变量：{{title}}、{{uin}}、{{nickname}}、{{event}}、{{time}}",
        "default": "【SnowLuma 状态通知】您的账号 {{nickname}}({{uin}}) 已于 {{time}} {{event}}"
      },
      "body": {
        "description": "邮件正文模板 (HTML)",
        "type": "text",
        "editor_mode": true,
        "editor_language": "html",
        "hint": "支持 HTML 格式，可使用模板变量：{{title}}、{{uin}}、{{nickname}}、{{event}}、{{time}}、{{desp}}、{{desp_html}}",
        "default": "<div style=\"max-width:600px;margin:0 auto;font-family:Arial,sans-serif;color:#333;\">\n  <div style=\"background:#3498db;padding:20px;border-radius:8px 8px 0 0;\">\n    <h1 style=\"color:#fff;margin:0;font-size:22px;\">SnowLuma 账号状态通知</h1>\n  </div>\n  <div style=\"background:#fff;padding:25px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px;\">\n    <table style=\"width:100%;border-collapse:collapse;margin:15px 0;\">\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;width:100px;\">昵称</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{nickname}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">QQ号</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{uin}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">当前状态</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{event}}</td></tr>\n      <tr><td style=\"padding:10px 12px;background:#f8f9fa;border:1px solid #e9ecef;font-weight:bold;\">时间</td><td style=\"padding:10px 12px;border:1px solid #e9ecef;\">{{time}}</td></tr>\n    </table>\n    <p style=\"color:#888;font-size:13px;margin-top:20px;border-top:1px solid #eee;padding-top:15px;\">Powered By：香草味的纳西妲喵（VanillaNahida） | 此邮件由 AstrBot 离线通知插件自动发送</p>\n  </div>\n</div>"
      }
    }
  },
  "qq_reminder": {
    "description": "QQ 号主动提醒配置（掉线时由另一个机器人私聊提醒指定 QQ）",
    "type": "object",
    "hint": "开启后，账号离线时会额外通过指定的机器人实例，向下列 QQ 号发送私聊提醒。与邮件通知同时生效，可单独使用。",
    "items": {
      "enabled": {
        "description": "启用 QQ 号提醒",
        "type": "bool",
        "default": false,
        "hint": "勾选后，掉线时除发邮件外，还会私聊提醒下方指定的 QQ 号。"
      },
      "target_qq": {
        "description": "提醒接收人 QQ 号",
        "type": "list",
        "default": [],
        "_special": "sender_id",
        "hint": "要接收提醒的 QQ 号，可填多个。点击右侧按钮可从聊天记录中选择用户。"
      },
      "platform_id": {
        "description": "发送提醒的机器人实例 ID",
        "type": "string",
        "default": "",
        "hint": "OneBot v11 直发时的机器人实例 ID（如 napcat）。使用 QQ 官方机器人提醒时此项无需填写。⚠️ 不要填被监控的那个账号，它掉线后自己发不出消息。"
      },
      "content": {
        "description": "提醒内容模板",
        "type": "text",
        "editor_mode": true,
        "editor_language": "text",
        "default": "🔔 账号掉线提醒\n账号：{nickname}（{uin}）\n平台：{platform}\n时间：{time}\n状态：{event}\n{extra}",
        "hint": "自定义提醒正文，支持变量：{nickname} {uin} {platform} {time} {event} {extra}（也兼容双花括号写法 {{nickname}}）。"
      },
      "prefix": {
        "description": "消息前缀",
        "type": "string",
        "default": "",
        "hint": "可选。会在提醒正文前加一句前缀，例如「【监控提示】」。"
      },
      "umo": {
        "description": "会话 UMO（可选，留空即可）",
        "type": "string",
        "default": "",
        "_special": "umo",
        "hint": "一般无需填写。机器人收到任何私聊消息时，插件会自动记录该会话 UMO 并保存到插件数据目录 qq_notifier_umo.json，之后主动推送直接复用（QQ 官方机器人走这条通道）。如自动记录失败，也可手动填入 umo，多个用逗号分隔。"
      },
      "auto_remember_umo": {
        "description": "自动记录会话 UMO",
        "type": "bool",
        "default": true,
        "hint": "开启后，机器人收到私聊消息时会自动保存该会话 UMO，用于后续主动推送（QQ 官方机器人必需）。"
      }
    }
  }
}